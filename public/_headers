# Cloudflare Pages cache rules.
#
# The build gives every asset under /_astro/ a content hash, so those files can
# be cached hard and forever: a change produces a new filename. HTML must never
# be cached hard, because it is what points at those hashed filenames. Getting
# this backwards is what made stale pages reference deleted stylesheets and
# render unstyled.
#
# Rules are matched most specific first, so the catch-all at the bottom governs
# every HTML page. Only genuinely fingerprinted or rarely changing binary files
# are pinned above it, and no rule above the catch-all may match a page URL.

# Content-hashed build output: safe to cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The search index, rebuilt with the site but stable between deploys.
/pagefind/*
  Cache-Control: public, max-age=86400

# Downloadable course material. These are binaries, never HTML, so a day of
# caching costs nothing and saves re-downloading multi-megabyte PDFs.
/downloads/*
  Cache-Control: public, max-age=86400

/learnings/*/submissions/*
  Cache-Control: public, max-age=86400

/learnings/*/notebooks/*
  Cache-Control: public, max-age=86400

# Icons and the manifest.
/icon-192.png
  Cache-Control: public, max-age=604800

/icon-512.png
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/manifest.webmanifest
  Cache-Control: public, max-age=3600

# The teardown service worker must never be served from cache, or a device
# cannot pick it up and free itself.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Everything else is HTML and revalidates on every visit. The response still
# carries an ETag, so an unchanged page costs a 304 and no download.
/*
  Cache-Control: public, max-age=0, must-revalidate
